# Kopiér til .env og udfyld. .env må aldrig komme i git.

PORT=3000
NODE_ENV=development

# Lang tilfældig streng (mindst 32 tegn) til at signere session-cookies.
# Lav en med: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Udviklingsdatabasen på serveren, via SSH-tunnelen (npm run db:tunnel).
# Port 5433 på din computer sendes krypteret videre til PostgreSQL på serveren.
DATABASE_URL=postgres://pudseren_dev:ADGANGSKODE@localhost:5433/pudseren_dev

# Testdatabasen. Testene sletter alt i den hver gang, så det må aldrig være den samme som ovenfor.
TEST_DATABASE_URL=postgres://pudseren_dev:ADGANGSKODE@localhost:5433/pudseren_test
