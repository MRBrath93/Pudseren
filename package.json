{
  "name": "pudseren",
  "private": true,
  "version": "0.1.0",
  "description": "Kunder, ruter og dagens rute for et lille vinduespudsningsfirma",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "db:tunnel": "ssh -N -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -L 5433:localhost:5432 pudseren",
    "db:migrate": "npm run db:migrate --workspace server",
    "user:create": "npm run user:create --workspace server",
    "test": "npm test --workspace server",
    "test:watch": "npm run test:watch --workspace server"
  },
  "engines": {
    "node": ">=20"
  }
}
